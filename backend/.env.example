# Boldr backend — copy to .env and fill in. Real secrets are never committed.

# ── App ──────────────────────────────────────────────
ENV=dev                              # dev | prod
DEBUG=true
API_PREFIX=/api/v1
# CORS_ORIGINS: JSON array or comma-separated. Dev keeps the Vite server (5173).
# In prod with a same-origin SPA (STATIC_DIR set) CORS is effectively a no-op;
# otherwise set this to your SPA origin(s), e.g. ["https://app.example.com"].
CORS_ORIGINS=["http://localhost:5173"]
# STATIC_DIR=../frontend/dist        # set in prod to serve the built React app

# ── Database (Postgres + pgvector) ───────────────────
# No Docker. Local Postgres now → swap to Neon (free) later by changing these URLs.
# Two URLs: async (asyncpg) for the app, sync (psycopg) for Alembic migrations.
# On Vercel/Neon use the POOLED host (e.g. "-pooler") for the async URL so
# short-lived serverless functions don't exhaust connections, and a direct host
# for the sync URL. Run migrations out-of-band (not on cold start).
DATABASE_URL_ASYNC=postgresql+asyncpg://boldr:boldr@127.0.0.1:5432/boldr
DATABASE_URL_SYNC=postgresql+psycopg://boldr:boldr@127.0.0.1:5432/boldr
DB_POOL_SIZE=5
DB_ECHO=false

# ── LLM (provider-agnostic via LangChain → OpenRouter) ─
OPENROUTER_API_KEY=sk-or-REPLACE_ME
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── KB / embeddings (via OpenRouter embeddings endpoint — reuses OPENROUTER_API_KEY) ──
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
EMBEDDING_DIM=2048                 # MUST match the vector(N) column / migration
# EMBEDDING_BASE_URL=              # defaults to OPENROUTER_BASE_URL
KB_TOP_K=5

# ── Observability ────────────────────────────────────
LOG_LEVEL=INFO
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
